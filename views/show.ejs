<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FlexGram | Post Details</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-900 p-4">
  <div class="mx-auto max-w-2xl rounded-2xl bg-white p-4 shadow-xl sm:p-6">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <p class="text-xs uppercase tracking-wider text-gray-500">Posted by</p>
        <h2 class="text-xl font-bold text-gray-800"><%= post.username %></h2>
      </div>
      <a href="/posts" class="rounded-full bg-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700">Back</a>
    </div>

    <img src="<%= post.image %>" alt="Post image" class="h-[420px] w-full rounded-xl object-cover">

    <div class="mt-4">
      <p class="text-2xl font-semibold text-gray-800"><%= post.likes %> likes</p>
      <p class="mt-3 text-gray-700"><span class="font-bold"><%= post.username %></span> <%= post.caption %></p>
    </div>

    <% if (user && (user.isAdmin || user.username === post.username)) { %>
      <div class="mt-6 flex gap-3">
        <a href="/posts/<%= post._id %>/edit" class="flex-1 rounded-lg border border-pink-500 px-4 py-2 text-center font-medium text-pink-600">Edit</a>
        <form method="POST" action="/posts/<%= post._id %>?_method=DELETE" class="flex-1">
          <button type="submit" class="w-full rounded-lg bg-red-500 px-4 py-2 font-medium text-white">Delete</button>
        </form>
      </div>
    <% } %>
  </div>
</body>
</html>