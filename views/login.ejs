<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | FlexGram</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #020617;
    }

    .video-bg {
      filter: brightness(0.55) saturate(1.1);
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center overflow-hidden relative">
  <div class="fixed inset-0 -z-20 overflow-hidden">
    <video autoplay muted loop playsinline class="video-bg h-full w-full object-cover">
      <source src="/uploads/dure.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-slate-950/35"></div>
  </div>

  <div class="w-full max-w-md px-4">
    <div class="rounded-2xl border border-white/20 bg-white/10 backdrop-blur-md p-5 shadow-2xl shadow-black/30 sm:p-8">
      <h1 class="text-2xl font-bold text-center text-white mb-2 sm:text-3xl">FlexGram</h1>
      <p class="text-center text-sm text-gray-200 mb-6">Login with your username</p>

      <% if (error) { %>
        <div class="mb-4 bg-red-100 border border-red-300 text-red-700 px-4 py-2 rounded-lg text-sm">
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/login" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-100 mb-2">Username</label>
          <input type="text" name="username" placeholder="amaanhussain786_" required
                 class="w-full px-4 py-2.5 border border-white/20 rounded-lg bg-white/10 text-white placeholder:text-gray-300 focus:ring-2 focus:ring-pink-400 focus:border-transparent outline-none">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-100 mb-2">Password</label>
          <input type="password" name="password" placeholder="Enter password" required
                 class="w-full px-4 py-2.5 border border-white/20 rounded-lg bg-white/10 text-white placeholder:text-gray-300 focus:ring-2 focus:ring-pink-400 focus:border-transparent outline-none">
        </div>

        <button type="submit" class="w-full bg-gradient-to-r from-pink-500 to-orange-500 text-white py-3 rounded-lg font-medium hover:shadow-lg transition-all">
          Login
        </button>
      </form>

      
    </div>
  </div>
</body>
</html>
