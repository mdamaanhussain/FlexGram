<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Post | FlexGram</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-900 flex items-center justify-center p-4">
  <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-xl">
    <h1 class="text-2xl font-bold text-center text-gray-800 mb-6">Edit Post</h1>

    <div class="mb-4 text-sm text-gray-600 text-center">
      Posted by <span class="font-bold text-pink-600"><%= post.username %></span>
    </div>

    <form method="POST" action="/posts/<%= post._id %>?_method=PATCH" class="space-y-5">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Caption</label>
        <textarea name="caption" rows="5" required class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-pink-400 focus:outline-none focus:ring-2 focus:ring-pink-200"><%= post.caption %></textarea>
      </div>

      <div class="flex gap-3">
        <a href="/posts/<%= post._id %>" class="flex-1 rounded-lg bg-gray-200 px-4 py-3 text-center font-medium text-gray-800">Cancel</a>
        <button type="submit" class="flex-1 rounded-lg bg-gradient-to-r from-pink-500 to-orange-500 px-4 py-3 font-medium text-white">Update</button>
      </div>
    </form>
  </div>
</body>
</html>